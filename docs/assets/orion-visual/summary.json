    "gigatime_model_mpp": 0.25,
    "cell_identity": "Published ORION CellID. Independent H&E StarDist nuclei are majority-overlap matched to that ID; cytoplasm excludes matched nuclear pixels.",
    "marker_pairing": "Six exact protein names, three related target families/complexes, plus DAPI/Hoechst as a dye control. No other marker names are substituted.",
    "methods": [
      "whole_cell_mean",
      "cytoplasm_mean",
      "nucleus_mean",
      "whole_cell_maximum",
      "cytoplasm_maximum",
      "nucleus_maximum",
      "nucleus_minus_cytoplasm",
      "cytoplasm_minus_nucleus",
      "whole_cell_local_contrast",
      "cytoplasm_local_contrast",
      "nucleus_local_contrast"
    ],
    "local_contrast_definition": "Predicted per-cell mean minus the median predicted mean of the 64 nearest other common cells on the same image; a label-free test of broad virtual-marker shading. Added before inspecting any reserved-evaluation protein correlation.",
